{
  "name": "obsidian-chrono-notes",
  "version": "0.4.3",
  "description": "A calendar workspace for periodic notes, calendar extensions, regional holidays, tasks, and time ranges.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "pnpm typecheck && pnpm build:bundle && pnpm artifact:check",
    "build:bundle": "node esbuild.config.mjs production",
    "artifact:check": "node scripts/check-production-bundle.mjs",
    "release:archive": "node scripts/release-assets.mjs archive",
    "acceptance:vault:create": "pnpm build && node scripts/acceptance-vault.mjs create",
    "acceptance:vault:verify": "node scripts/acceptance-vault.mjs verify",
    "acceptance:vault:clean": "node scripts/acceptance-vault.mjs clean",
    "acceptance:vault:prune": "node scripts/acceptance-vault.mjs prune",
    "size": "pnpm build:bundle && node scripts/check-production-bundle.mjs --details",
    "bench:quick": "vitest run --config vitest.performance.config.ts --mode quick --reporter=verbose",
    "bench:large": "vitest run --config vitest.performance.config.ts --mode large --reporter=verbose",
    "bench:single-file:large": "vitest run benchmarks/single-file-update-guardrail.test.ts --config vitest.performance.config.ts --mode large --reporter=verbose",
    "holiday:check": "node scripts/check-holiday-coverage.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "lint": "eslint main.ts src tests benchmarks scripts --max-warnings 0",
    "format:check": "node scripts/check-source-style.mjs",
    "check:readme-i18n": "node scripts/check-readme-i18n.mjs",
    "check:docs-i18n": "node scripts/check-docs-i18n.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:timezones": "node scripts/run-tests-in-timezones.mjs",
    "check": "node scripts/check-runtime.mjs && pnpm lint && pnpm format:check && pnpm check:readme-i18n && pnpm check:docs-i18n && pnpm typecheck && pnpm test && pnpm build:bundle && pnpm artifact:check",
    "release:check": "pnpm check && pnpm test:timezones && pnpm bench:quick && pnpm bench:single-file:large && pnpm holiday:check"
  },
  "keywords": [
    "obsidian",
    "calendar",
    "periodic-notes",
    "lunar-calendar",
    "persian-calendar",
    "hebrew-calendar",
    "islamic-calendar"
  ],
  "author": "ZhengYX",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.18.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "^0.27.0",
    "eslint": "10.7.0",
    "eslint-plugin-obsidianmd": "0.4.1",
    "globals": "^15.15.0",
    "happy-dom": "20.10.6",
    "obsidian": "1.13.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "ical.js": "2.2.1",
    "lucide-react": "0.468.0",
    "lunar-typescript": "1.8.6",
    "luxon": "^3.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.0"
  }
}
